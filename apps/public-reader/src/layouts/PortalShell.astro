---
import "../styles/portal.css";
import ChatwootWidget from "../components/ChatwootWidget.astro";
import {
  portalMobileActivePath,
  portalMobileNavItems,
  portalNavItems,
  type PortalPageId
} from "../lib/portal-routes.js";

interface Props {
  activePage: PortalPageId;
  title: string;
  description: string;
  hideFooter?: boolean;
  noindex?: boolean;
}

const { activePage, title, description, hideFooter = false, noindex = false } = Astro.props;
const siteName = "FreedomPost";
const pageTitle = activePage === "home" ? siteName : `${title} - ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://example.com").toString();
const mobileActivePath = portalMobileActivePath(Astro.url.pathname);
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/images/freedompost-editorial-hero.webp", canonicalUrl).toString()} />
    <meta name="theme-color" content="#151714" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="portal-page" data-page={activePage}>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="portal-brand" href="/" data-portal-route aria-label="FreedomPost 首页">
          <span class="portal-brand-mark">F</span>
          <span class="portal-brand-copy">
            <strong>FreedomPost</strong>
            <small>自由发布</small>
          </span>
        </a>

        <button id="navToggle" class="portal-icon-button nav-toggle" type="button" aria-label="打开导航" aria-expanded="false">
          <i data-lucide="menu"></i>
        </button>

        <nav id="primaryNav" class="primary-nav" aria-label="主导航">
          {
            portalNavItems.map((item) => (
              <a class:list={["nav-link", "className" in item ? item.className : undefined, { active: activePage === item.id }]} href={item.href} data-portal-route aria-current={activePage === item.id ? "page" : undefined}>
                <span class="nav-link-label">{item.label}</span>
                {"tagline" in item && <small class="earn-nav-tagline">{item.tagline}</small>}
              </a>
            ))
          }
        </nav>

        <div class="header-actions">
          <span id="servicePulse" class="service-pulse" data-status="checking">
            <span></span>
            <b>服务检测中</b>
          </span>
          <button id="portalThemeBtn" class="portal-icon-button" type="button" aria-label="切换主题" title="切换主题">
            <i data-lucide="sun"></i>
          </button>
        </div>
      </div>
    </header>

    <main id="portalContent" data-portal-content>
      <slot />
    </main>

    <footer id="portalFooter" class="portal-footer" hidden={hideFooter}>
      <div class="portal-footer-inner">
        <a class="portal-brand footer-brand" href="/" data-portal-route>
          <span class="portal-brand-mark">F</span>
          <span class="portal-brand-copy"><strong>FreedomPost</strong><small>让内容先被看见</small></span>
        </a>
        <p>一个专注写作、发布与阅读的独立内容空间。</p>
        <nav aria-label="页脚导航">
          <a href="/articles/" data-portal-route>全部文章</a>
          <a href="/guide/" data-portal-route>使用指南</a>
          <a href="/about/" data-portal-route>关于本站</a>
        </nav>
      </div>
    </footer>

    <nav class="mobile-bottom-nav" aria-label="移动端主导航">
      {
        portalMobileNavItems.map((item) => (
          <a class:list={["mobile-bottom-link", { active: mobileActivePath === item.href }]} href={item.href} data-portal-route aria-current={mobileActivePath === item.href ? "page" : undefined}>
            <i data-lucide={item.icon}></i>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <div id="portalToast" class="portal-toast" role="status" aria-live="polite"></div>
    <ChatwootWidget />
    <script>
      import "../scripts/portal.ts";
    </script>
  </body>
</html>
