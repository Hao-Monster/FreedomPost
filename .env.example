NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true
LOG_LEVEL=info
API_BODY_LIMIT_BYTES=104857600
UPLOAD_MAX_BYTES=524288000

COOKIE_SECRET=change-me
COOKIE_SECURE=true
PUBLIC_SITE_URL=https://example.com
VITE_PUBLIC_SITE_URL=https://example.com
VISITOR_HASH_SALT=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=freedompost-dev
# ADMIN_PASSWORD_HASH=

POSTGRES_DB=freedompost
POSTGRES_USER=freedompost
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://freedompost:change-me@postgres:5432/freedompost
# Set to memory for local API demos without PostgreSQL.
FREEDOMPOST_REPOSITORY=postgres
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
# [M5] Redis password — generate with: openssl rand -base64 32
REDIS_PASSWORD=change-me-use-openssl-rand-base64-32

# Paid articles are disabled until the Go service, migration, and routes are deployed together.
PAID_ARTICLES_ENABLED=false
PAID_ACCESS_ADDR=:8080
PAID_ACCESS_INTERNAL_URL=http://paid-access:8080
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
PAID_ACCESS_INTERNAL_SECRET=
PAID_ACCESS_WECHAT_IMAGE_URL=/images/contact-wechat.jpg

# Webmaster benefit remains disabled in the database until release activation.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=example.com
TURNSTILE_EXPECTED_ACTION=webmaster_benefit_claim
TURNSTILE_TIMEOUT_MS=3000
OPUS8_INTEGRATION_BASE_URL=https://api.example.com
OPUS8_INTEGRATION_KEY_ID=
OPUS8_INTEGRATION_SECRET=
OPUS8_INTEGRATION_TIMEOUT_MS=5000
BENEFIT_CLAIM_HMAC_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BENEFIT_LINK_ENCRYPTION_KEY=
BENEFIT_NETWORK_DAILY_LIMIT=3
BENEFIT_CLAIM_MINUTE_LIMIT=6
CORS_ALLOWED_ORIGINS=

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=runtime/local-storage
PUBLIC_UPLOAD_BASE_URL=/api/uploads

ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_PREFIX=freedompost/uploads
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# R2 storage (Cloudflare)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_PREFIX=freedompost/uploads

# ─── Go API service (services/api) ────────────────────────────────────────────
# The Go API reads the variables above, plus:

# bcrypt hash of ADMIN_PASSWORD — generate with:
#   ./fp-api -hash-password "your-strong-password"
# If empty, the Go API falls back to ADMIN_PASSWORD (plain, dev only).
ADMIN_PASSWORD_HASH=

# Sliding window view buffer flush interval (default: 30s)
VIEW_BUFFER_FLUSH_INTERVAL=30s
