(freedompost_site) {
	root * /var/www/freedompost/public
	encode gzip

	request_body {
		max_size 512MB
	}

	# [H1] Block /internal/* — paid-access internal routes must never be
	# reachable from the public internet. They are signed with HMAC, but
	# minimising exposed attack surface is a defence-in-depth measure.
	handle /internal/* {
		respond 404
	}

	header {
		X-Content-Type-Options "nosniff"
		# [M1] Use SAMEORIGIN — admin panel cannot be embedded externally, but local iframes (like /articles/ embedding /reader/) will work.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: blob:; media-src 'self' https: blob:; script-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
	}
	@benefitApi path /api/benefits/webmaster*
	header @benefitApi Cache-Control "no-store"
	@readerApi path /api/reader/*
	header @readerApi Cache-Control "private, no-store"

	@legacyTopics path /topics /topics/
	redir @legacyTopics /benefit/?{query} permanent

	# [M4] Force-overwrite X-Forwarded-For so paid-access cannot be tricked
	# by a client supplying a crafted XFF header to bypass IP rate limits.
	handle /api/reader/* {
		reverse_proxy paid-access:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /api/* {
		reverse_proxy api-go:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /health {
		reverse_proxy api-go:3000
	}

	handle /health/ready {
		reverse_proxy api-go:3000
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /admin/* {
		header Cache-Control "no-store"
		try_files {path} {path}/ /admin/index.html
		file_server
	}

	handle /p/* {
		header Cache-Control "public, max-age=60, stale-while-revalidate=600"
		try_files {path} {path}/index.html {path}/ /reader-shell/index.html
		file_server
	}

	handle /search/* {
		header Cache-Control "public, max-age=60, stale-while-revalidate=600"
		try_files {path} =404
		file_server
	}

	handle {
		header Cache-Control "public, max-age=60, stale-while-revalidate=600"
		try_files {path} {path}/ /index.html
		file_server
	}
}

{$PREVIEW_DOMAIN} {
	import freedompost_site
}

https://{$ORIGIN_TEST_HOST} {
	tls internal
	redir https://{$PREVIEW_DOMAIN}{uri} permanent
}

http://{$ORIGIN_TEST_HOST} {
	redir https://{$PREVIEW_DOMAIN}{uri} permanent
}
