{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(freedompost_site) {
	root * /var/www/freedompost/public
	encode gzip

	request_body {
		max_size 512MB
	}

	# [H1] Block /internal/* — paid-access internal routes must never be
	# reachable from the public internet. They are signed with HMAC, but
	# minimising exposed attack surface is a defence-in-depth measure.
	handle /internal/* {
		respond 404
	}

	header {
		X-Content-Type-Options "nosniff"
		# [M1] Use SAMEORIGIN — admin panel cannot be embedded externally, but local iframes (like /articles/ embedding /reader/) will work.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: blob:; media-src 'self' https: blob:; script-src 'self' https://challenges.cloudflare.com https://chat.clawpan.online; frame-src 'self' https://challenges.cloudflare.com https://chat.clawpan.online https://www.youtube-nocookie.com; connect-src 'self' https://challenges.cloudflare.com https://chat.clawpan.online wss://chat.clawpan.online; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
	}
	@benefitApi path /api/benefits/webmaster*
	header @benefitApi Cache-Control "no-store"
	@readerApi path /api/reader/*
	header @readerApi Cache-Control "private, no-store"
	# Admin APIs must share the dedicated hostname's Access boundary.
	@adminApi path /api/admin /api/admin/*
	handle @adminApi {
		respond 404
	}

	@legacyTopics path /topics /topics/
	redir @legacyTopics /benefit/?{query} permanent

	# [M4] Force-overwrite X-Forwarded-For with Caddy's verified {client_ip}
	# (extracted from CF-Connecting-IP only when remote_host is in Cloudflare's
	# trusted_proxies ranges, otherwise falling back to remote_host).
	handle /api/reader/* {
		reverse_proxy paid-access:8080 {
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Real-IP
		}
	}

	handle /api/* {
		reverse_proxy api-go:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Real-IP
		}
	}

	handle /health {
		reverse_proxy api-go:3000
	}

	handle /health/ready {
		reverse_proxy api-go:3000
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /admin/* {
		respond 404
	}

	handle /p/* {
		header Cache-Control "public, max-age=60, stale-while-revalidate=600"
		try_files {path} {path}/index.html {path}/ /reader-shell/index.html
		file_server
	}

	handle /search/* {
		header Cache-Control "public, max-age=60, stale-while-revalidate=600"
		try_files {path} =404
		file_server
	}

	handle {
		header Cache-Control "public, max-age=60, stale-while-revalidate=600"
		try_files {path} {path}/ /index.html
		file_server
	}
}

# Dedicated admin origin. Cloudflare Access must protect this entire hostname
# (including /api/*); application-level requireAdmin remains mandatory.
admin-freedompost.thinderbox.uk {
	# Full (strict) requires a trusted origin certificate covering this hostname.
	tls /etc/caddy/certs/admin-origin.crt /etc/caddy/certs/admin-origin.key
	root * /var/www/freedompost/admin
	encode gzip
	request_body {
		max_size 512MB
	}
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: blob:; media-src 'self' https: blob:; script-src 'self'; frame-src 'self' https://www.youtube-nocookie.com; connect-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}
	handle /api/* {
		reverse_proxy api-go:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Real-IP
		}
	}
	handle /health {
		reverse_proxy api-go:3000
	}
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}

{$PREVIEW_DOMAIN} {
	import freedompost_site
}

https://{$ORIGIN_TEST_HOST} {
	tls internal
	redir https://{$PREVIEW_DOMAIN}{uri} permanent
}

http://{$ORIGIN_TEST_HOST} {
	redir https://{$PREVIEW_DOMAIN}{uri} permanent
}
